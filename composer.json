{
    "name": "9in/laravel-events",
    "description": "Events shared by the 9in Laravel packages: adapter notifications (9in/laravel-server) and webhooks (9in/laravel).",
    "keywords": [
        "9in",
        "sso",
        "laravel",
        "events",
        "webhooks"
    ],
    "homepage": "https://9in.io",
    "license": "MIT",
    "authors": [
        {
            "name": "9in",
            "email": "support@9in.io"
        },
        {
            "name": "Cubelet Ltd.",
            "email": "info@cubelet.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.11",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nine\\Laravel\\Events\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nine\\Laravel\\Events\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fixer": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
